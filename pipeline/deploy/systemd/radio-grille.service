[Unit]
Description=AubeSonore : grille du lendemain dans les playlists horaires d'AzuraCast
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/aubesonore/pipeline
EnvironmentFile=%h/aubesonore/pipeline/.env
Nice=19
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio grille
# Battement de cœur vers Gatus, même en échec (deploy/heartbeat.sh).
ExecStopPost=-%h/aubesonore/pipeline/deploy/heartbeat.sh radio_grille
