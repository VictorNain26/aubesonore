[Unit]
Description=AubeSonore : courriel d'alerte, %i.service en échec
# Instanciée par l'OnFailure= de radio-weekly, radio-grille et radio-backup (systemd.unit(5),
# « OnFailure= » et « Specifiers ») : %i est l'unité en échec, sans son suffixe. Elle-même n'a
# pas d'OnFailure= : une alerte qui échoue (relais non configuré ou injoignable) reste en échec
# dans `systemctl --user list-units --failed`.

[Service]
Type=oneshot
WorkingDirectory=%h/aubesonore/pipeline
EnvironmentFile=%h/aubesonore/pipeline/.env
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio alert %i.service
