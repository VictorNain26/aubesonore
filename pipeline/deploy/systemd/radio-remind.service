[Unit]
Description=AubeSonore v3 : rappel WhatsApp des votes
After=network-online.target
# Ordonnancement seul (pas Requires=/Wants=) : le rappel part même si la passe hebdomadaire a
# échoué. Les deux minuteries Persistent=true se déclenchent ensemble au démarrage après une
# panne du dimanche ; une passe lente (jusqu'à 12 h) peut dépasser 10:00.
After=radio-weekly.service

[Service]
Type=oneshot
WorkingDirectory=%h/aubesonore/pipeline
EnvironmentFile=%h/aubesonore/pipeline/.env
Nice=19
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio votes-remind
# Battement de cœur vers Gatus, même en échec (même mécanisme que radio-weekly).
ExecStopPost=-/bin/sh -c 'curl -fsS -m 10 -X POST -H "Authorization: Bearer $GATUS_TOKEN" "http://127.0.0.1:8050/api/v1/endpoints/radio_rappel/external?success=$([ "$SERVICE_RESULT" = success ] && echo true || echo false)&error=$SERVICE_RESULT"'
