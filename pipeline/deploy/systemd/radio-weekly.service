[Unit]
Description=AubeSonore : passe hebdomadaire
After=network-online.target
# En échec, un courriel au propriétaire (radio-alert@.service ; systemd.unit(5), « OnFailure= »,
# et %N, le nom de cette unité sans « .service », dans « Specifiers »).
OnFailure=radio-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/aubesonore/pipeline
# Sockseek et rsgain sont dans ~/.local/bin ; ffmpeg et fpcalc viennent d'apt.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/aubesonore/pipeline/.env
# Machine partagée : la diffusion et les autres services passent avant.
Nice=19
CPUWeight=20
IOSchedulingClass=idle
# Pic mesuré : 2,9 Go (passe du 2026-10-01). Au-delà de MemoryHigh la passe est ralentie,
# quitte à passer en swap ; MemoryMax est la dernière ligne de défense et l'arrête
# (systemd.resource-control(5)).
MemoryHigh=3584M
MemoryMax=4608M
TimeoutStartSec=12h
# Config Sockseek (mot de passe Soulseek) sur tmpfs, sous $XDG_RUNTIME_DIR ; exportée en
# $RUNTIME_DIRECTORY et supprimée à l'arrêt de l'unité, même tuée au délai (systemd.exec(5)).
RuntimeDirectory=radio-weekly
RuntimeDirectoryMode=0700
# Une étape en échec arrête la suite : pas de sélection sur des notes périmées.
# gout ne réentraîne que s'il y a des votes nouveaux ou corrigés ; il note toujours les candidats.
# nouveautes, favoris et telechargement préfixés de « - » : une source en panne n'arrête pas la
# passe, et un échec de telechargement n'empêche pas antenne de publier ce qui est prêt
# (systemd.service(5), « Command lines ») ; bilan fait échouer la passe en fin de course.
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio bibliotheque
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio decouverte
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio nouveautes
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio favoris
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio empreintes
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio gout
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio tirage
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio telechargement
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio antenne
# mesures préfixée de « - » : bilan tourne quand même et fait échouer la passe sur cette étape,
# avec le résumé de toutes les autres.
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio mesures
# La passe a fait entrer, sortir ou mettre au repos des titres : la grille du jour est réécrite
# pour les heures qui restent.
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio grille --aujourdhui
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio bilan
