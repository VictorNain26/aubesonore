[Unit]
Description=AubeSonore : passe hebdomadaire
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/aubesonore/pipeline
# Sockseek et rsgain sont dans ~/.local/bin ; ffmpeg et fpcalc viennent d'apt.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/aubesonore/pipeline/.env
# Machine partagée : la diffusion et les autres services passent avant.
Nice=19
CPUWeight=20
IOSchedulingClass=idle
# Pic mesuré : 2,9 Go (passe du 2026-10-01). Au-delà de MemoryHigh la passe est ralentie,
# MemoryMax est la dernière ligne de défense (systemd.resource-control(5)) : une fuite ne peut
# plus pousser la diffusion vers le swap.
MemoryHigh=3584M
MemoryMax=4608M
TimeoutStartSec=12h
# Config Sockseek (mot de passe Soulseek) sur tmpfs, sous $XDG_RUNTIME_DIR ; exportée en
# $RUNTIME_DIRECTORY et supprimée à l'arrêt de l'unité, même tuée au délai (systemd.exec(5)).
RuntimeDirectory=radio-weekly
RuntimeDirectoryMode=0700
# Une étape en échec arrête la suite : pas de sélection sur des notes périmées.
# train ne réentraîne que s'il y a de nouveaux votes ; il note toujours les candidats.
# nouveautes, favoris et acquire préfixés de « - » : une source en panne n'arrête pas la
# passe, et un échec d'acquire n'empêche pas antenne de publier ce qui est prêt
# (systemd.service(5), « Command lines ») ; check fait échouer la passe en fin de course.
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio library-sync
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio discover
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio nouveautes
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio favoris
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio signals
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio train
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio votes-select
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio acquire
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio antenne
# mesures préfixée de « - » : check tourne quand même et fait échouer la passe sur cette étape,
# avec le résumé de toutes les autres.
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio mesures
# La passe a fait entrer, sortir ou mettre au repos des titres : la grille du jour est réécrite
# pour les heures qui restent.
ExecStart=-%h/aubesonore/pipeline/.venv/bin/radio grille --aujourdhui
ExecStart=%h/aubesonore/pipeline/.venv/bin/radio check
# Battement de cœur vers Gatus, même en échec : $SERVICE_RESULT vaut « success » ou la cause
# (systemd.exec(5), « Environment Variables Set or Propagated by the Service Manager »).
# Préfixé de « - » (systemd.service(5), « Command lines ») : un Gatus injoignable ou qui
# répond 404 ne fait pas échouer une passe réussie (radio-grille, 2026-10-02) ; le battement
# manqué déclenche quand même l'alerte de silence.
ExecStopPost=-/bin/sh -c 'curl -fsS -m 10 -X POST -H "Authorization: Bearer $GATUS_TOKEN" "http://127.0.0.1:8050/api/v1/endpoints/radio_passe-hebdo/external?success=$([ "$SERVICE_RESULT" = success ] && echo true || echo false)&error=$SERVICE_RESULT"'
