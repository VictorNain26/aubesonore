# Copier en .env (jamais commité). Les variables sans valeur par défaut sont obligatoires
# pour les commandes qui s'en servent.

PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
# Nom de la section musique Plex lue. Jamais « Musique second wave ».
PLEX_MUSIC_SECTION=Musique
PLEX_MUSIC_ROOT=/media/plex/Musique

LASTFM_API_KEY=

# Page de vote publiée par le tunnel Cloudflare, derrière Access (docs/vision.md §10).
RADIO_VOTES_URL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Rappel WhatsApp (CallMeBot).
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# Jeton du battement de cœur de la passe vers Gatus (deploy/gatus).
GATUS_TOKEN=
# Jeton des battements du site vers Gatus, à part : le même figure en GATUS_TOKEN dans site/.env.
GATUS_SITE_TOKEN=

# Sujet ntfy.sh des alertes Gatus, aléatoire : son nom fait office de secret.
NTFY_TOPIC=

# Compte Soulseek PROPRE à la radio (jamais celui de slskd : il l'éjecterait).
SOULSEEK_USER=
SOULSEEK_PASSWORD=

# AzuraCast local (jamais par Cloudflare : limite de taille et conditions d'usage).
AZURACAST_URL=http://127.0.0.1:8080
AZURACAST_API_KEY=
# Dossier média de la station, lu par « radio mesures » (défaut : ../azuracast/stations/aubesonore/media).
AZURACAST_MEDIA_DIR=

# Copie quotidienne de la base (radio backup), sur un autre disque physique que data/.
RADIO_BACKUP_DIR=/media/plex/.backups/radio
