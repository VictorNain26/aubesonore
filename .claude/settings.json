{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/azuracast/azuracast.env)",
      "Read(//media/musique/**)",
      "Edit(/musilogy/tests/fixtures/**)"
    ],
    "ask": [
      "Bash(*musilogy run musilogy run*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "pnpm -C site stack",
      "pnpm -C site data:pull",
      "pnpm -C site musilogy:sample",
      "pnpm -C site storybook"
    ],
    "network": {
      "allowedDomains": [
        "musicbrainz.org",
        "coverartarchive.org",
        "archive.org",
        "*.archive.org",
        "aubesonore.fr"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
