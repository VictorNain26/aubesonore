# Server Configuration
PORT=3000

# Database (local: docker-compose.dev.yml, match the port to POSTGRES_DEV_PORT)
DATABASE_URL=postgresql://aubesonore:aubesonore_secret@localhost:5432/aubesonore

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
# Dev: http://localhost:3000
# Prod: https://api.aubesonore.fr
BETTER_AUTH_URL=http://localhost:3000

# URLs
# Dev: http://localhost:8080 / http://localhost:3000
# Prod: https://aubesonore.fr / https://api.aubesonore.fr
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://localhost:3000

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
# Dev: http://localhost:8080,http://localhost:5173
# Prod: https://aubesonore.fr
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Cookie domain pour cross-subdomain (prod: .aubesonore.fr)
COOKIE_DOMAIN=

# Identifies the site to MusicBrainz and Wikimedia, which require a contact (default: https://aubesonore.fr)
OUTBOUND_USER_AGENT=

# AzuraCast (radio history proxy — key stays server-side)
# Optional: dev boots without it, but /api/radio/history returns 502 until set
AZURACAST_BASE_URL=
AZURACAST_API_KEY=
AZURACAST_STATION_ID=1

# YouTube Data API v3 key (Google Cloud console, restricted to that API): direct links
# to kept tracks. Optional: unset, each track opens a YouTube search.
YOUTUBE_API_KEY=

# SMTP — sign-up requires a verified email, so production refuses to start
# without SMTP_HOST unless DISABLE_EMAILS=true is set on purpose.
# Port 465 uses implicit TLS; 587 uses STARTTLS, required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AubeSonore <noreply@aubesonore.fr>

# Dev convenience: drops every mail and logs it instead of sending
DISABLE_EMAILS=true
