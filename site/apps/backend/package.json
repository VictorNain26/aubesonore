{
  "name": "@aubesonore/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "reset:all": "bun run src/scripts/reset-all.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "DRIZZLE_KIT_NO_PROMPT=true bunx drizzle-kit push",
    "seed:admin": "bun run src/scripts/seed-admin.ts",
    "seed:dev": "bun run src/scripts/seed-dev.ts",
    "artists:resolve": "bun run src/scripts/resolve-played-artists.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aubesonore/shared-types": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "better-auth": "^1.6.24",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "file-type": ">=21.3.2",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.20.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
