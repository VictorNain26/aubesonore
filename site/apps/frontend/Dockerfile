# =============================================================================
# AubeSonore Frontend — static SPA built from the pnpm workspace, served by nginx
# =============================================================================
# Build context is the repo root (the SPA depends on @aubesonore/core and
# @aubesonore/shared-types via `workspace:*`). The root .dockerignore excludes
# apps/frontend for the backend image, so this build relies on the adjacent
# Dockerfile.dockerignore, which takes precedence.

# -----------------------------------------------------------------------------
# Stage 1: install all workspace deps
# -----------------------------------------------------------------------------
FROM node:22-slim AS deps
RUN corepack enable pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/core/package.json ./packages/core/

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2: build the shared packages, then the SPA
# -----------------------------------------------------------------------------
FROM deps AS builder

COPY packages ./packages
COPY apps/frontend ./apps/frontend
COPY tsconfig.base.json ./

# Vite inlines these at build time, so they are baked into the bundle and are
# not runtime configuration. None of them is a secret.
ARG VITE_API_URL
ARG VITE_AZURACAST_BASE_URL
ARG VITE_STATION_SHORTCODE

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AZURACAST_BASE_URL=$VITE_AZURACAST_BASE_URL
ENV VITE_STATION_SHORTCODE=$VITE_STATION_SHORTCODE

# Paraglide messages are generated by paraglideVitePlugin during `vite build`
# (see vite.config.ts) — no separate compile step here.
RUN pnpm --filter @aubesonore/shared-types build && \
    pnpm --filter @aubesonore/core build && \
    pnpm --filter @aubesonore/frontend build

# -----------------------------------------------------------------------------
# Renderer: the artist pages' server render, for the backend (scripts/renderer.mjs).
# Built from the same build as the static assets: the markup it writes is the
# one the client hydrates. dist-ssr bundles its dependencies (vite.config.ts).
# -----------------------------------------------------------------------------
FROM node:22-alpine AS renderer

WORKDIR /app
COPY --from=builder /app/apps/frontend/dist-ssr ./dist-ssr
COPY apps/frontend/scripts/renderer.mjs ./
USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "renderer.mjs"]

# -----------------------------------------------------------------------------
# Stage 3: nginx runtime (static assets only, no Node in the final image)
# -----------------------------------------------------------------------------
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html
# The image filter module ships with the image; load_module belongs to the main context, which
# conf.d cannot reach. nginx.conf's /covers/ location uses it.
RUN sed -i '1i load_module modules/ngx_http_image_filter_module.so;' /etc/nginx/nginx.conf
COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/frontend/security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
