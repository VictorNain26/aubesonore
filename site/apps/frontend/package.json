{
  "name": "@aubesonore/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite --port 5173 --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "compile:i18n": "node scripts/compile-i18n.mjs",
    "lint": "pnpm compile:i18n && eslint .",
    "lint:fix": "pnpm compile:i18n && eslint . --fix",
    "typecheck": "pnpm compile:i18n && tsc --noEmit && tsc -p tsconfig.node.json --noEmit --composite false",
    "check:contrast": "node scripts/check-contrast.mjs",
    "preview": "vite preview",
    "storybook": "pnpm compile:i18n && storybook dev -p 6006 --no-open",
    "test": "vitest",
    "test:visual": "playwright test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aubesonore/shared-types": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@inlang/paraglide-js": "^2.22.0",
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "web-vitals": "^5.2.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@inlang/plugin-message-format": "4.4.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chromecast-caf-receiver": "6.0.27",
    "@types/chromecast-caf-sender": "1.0.11",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1"
  }
}
