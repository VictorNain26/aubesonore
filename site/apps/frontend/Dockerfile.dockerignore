# Ignore-file specific to apps/frontend/Dockerfile. A Dockerfile-scoped
# ignore-file takes precedence over the root .dockerignore, which excludes
# apps/frontend (needed for the backend image, fatal for this one).
# https://docs.docker.com/build/concepts/context/#dockerignore-files

node_modules
**/node_modules
.git
.turbo
**/dist
apps/backend
*.log
.env
.env.*

# Regenerated by paraglideVitePlugin during the build — never ship a stale copy
apps/frontend/src/paraglide

# Local-only build artefacts
coverage
apps/frontend/stats.html
