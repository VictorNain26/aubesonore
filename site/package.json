{
  "name": "aubesonore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@aubesonore/backend",
    "dev:frontend": "turbo dev --filter=@aubesonore/frontend",
    "build": "turbo build",
    "build:backend": "turbo build --filter=@aubesonore/backend",
    "build:frontend": "turbo build --filter=@aubesonore/frontend",
    "lint": "pnpm --filter=@aubesonore/frontend compile:i18n && eslint .",
    "lint:fix": "pnpm --filter=@aubesonore/frontend compile:i18n && eslint . --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "knip": "knip",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "prepare": "cd .. && husky site/.husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^9.36.0",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.25.0",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "workbox-window": "^7.4.1",
      "postcss": ">=8.5.23",
      "fast-uri": ">=3.1.8 <4",
      "serialize-javascript": ">=7.1.2",
      "flatted": ">=3.4.2",
      "file-type": ">=21.3.2",
      "minimatch": ">=3.1.4",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "picomatch": ">=2.3.2",
      "node-forge": ">=1.4.0",
      "defu": ">=6.1.7",
      "@xmldom/xmldom": ">=0.8.13",
      "eslint>ajv": "^6.14.0",
      "@eslint/eslintrc>ajv": "^6.14.0",
      "ajv": ">=8.18.0",
      "rollup": ">=2.80.0",
      "lodash": ">=4.18.0",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "shell-quote": ">=1.9.0",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "undici": ">=7.29.1 <8",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0"
    }
  }
}
