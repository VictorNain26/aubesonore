# AubeSonore — the environment compose.yaml reads.
# On a workstation: `cp .env.example .env` and `pnpm stack` run as they are (README).
# On the production box, .env holds the real secrets; each line below says what it is there.

# Workstation: development (plain cookies, no email). Production: leave unset (production).
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=aubesonore
# Production: a long random secret.
POSTGRES_PASSWORD=aubesonore-dev
POSTGRES_DB=aubesonore

# Better Auth. Production: 32+ random characters.
BETTER_AUTH_SECRET=dev-only-secret-never-used-in-production
# The browser reaches the API through Vite's proxy, on the page's own origin.
# Production: https://api.aubesonore.fr, https://api.aubesonore.fr, https://aubesonore.fr, https://aubesonore.fr
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Empty: host-only cookies. Production: unset, compose.yaml defaults it to .aubesonore.fr.
COOKIE_DOMAIN=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Features. Production: DISABLE_EMAILS=false with SMTP_* set (email verification needs it).
DISABLE_EMAILS=true
# Production: the SMTP relay that sends the verification emails. The backend refuses to boot
# in production without SMTP_HOST unless DISABLE_EMAILS=true; with it, it needs USER and PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AubeSonore <noreply@aubesonore.fr>

# YouTube Data API key: a kept track plays its Art Track. Empty: every track opens its search.
YOUTUBE_API_KEY=

# Whether the backend records the antenna's plays and resolves their artists (unset: true, as
# in production). A workstation leaves it to production, whose plays `pnpm data:pull` copies.
RECORD_ANTENNA=false

# Also read by apps/backend/src/config/env.ts (defaults there), set by compose.yaml's
# x-backend-environment or left to their default, never from this file: PORT, DATABASE_URL,
# DATABASE_SSL, DATABASE_CA_CERT, DATABASE_CA_CERT_FILE, DATABASE_POOL_MAX, OUTBOUND_USER_AGENT,
# FRONTEND_ORIGIN_INTERNAL, RENDERER_ORIGIN_INTERNAL.

# AzuraCast, read by the backend. Production: http://host.docker.internal:8080 and its API key.
AZURACAST_BASE_URL=https://radio.aubesonore.fr
AZURACAST_API_KEY=
AZURACAST_STATION_ID=1

# Workstation only: the test listener dev-init creates (test values, never a real account).
DEV_USER_EMAIL=dev@aubesonore.test
DEV_USER_PASSWORD=dev-listener-password
DEV_USER_NAME=Dev

# Workstation only, optional: production's public API, to relay the public reads (Musilogy,
# the artist pages, today's plays, the trends) instead of answering them from the local database
# (`pnpm musilogy:sample`, `pnpm data:pull`). Read only. Empty: everything local.
# PUBLIC_API_PROXY_TARGET=https://api.aubesonore.fr

# Frontend build (production's static image); unset, each takes production's value (compose.yaml).
# VITE_API_URL=https://api.aubesonore.fr
VITE_AZURACAST_BASE_URL=https://radio.aubesonore.fr
# VITE_STATION_SHORTCODE=aubesonore
