# Local mirror of the required CI checks: the GitHub Actions quota is
# limited, so the quality gate runs at push time — a red tree never
# leaves the machine. Mirrors .github/workflows/site.yml (format is
# already enforced by lint-staged at commit; coverage, audit and the tests
# against Postgres, which need a database, stay in CI).
set -e
# The repository also holds pipeline/, azuracast/ and musilogy/ (own CI): skip
# the site gate when nothing under site/ differs from origin/master. Checked
# from the root, before `cd`: in a worktree git exports GIT_DIR without
# GIT_WORK_TREE, so after `cd site` git takes site/ as the top of the tree and
# `.` meant the whole repository — every push from a worktree ran the gate.
if git rev-parse -q --verify origin/master >/dev/null && git diff --quiet origin/master...HEAD -- site; then
  exit 0
fi
cd site
pnpm turbo build --filter=@aubesonore/shared-types --filter=@aubesonore/core
pnpm lint
pnpm knip
pnpm turbo typecheck
pnpm --filter=@aubesonore/frontend check:contrast
pnpm --filter=@aubesonore/frontend test --run
pnpm --filter=@aubesonore/backend test
pnpm turbo build --filter=@aubesonore/backend --filter=@aubesonore/frontend
