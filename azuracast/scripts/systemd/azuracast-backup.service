[Unit]
Description=AubeSonore : sauvegarde restic chiffrée des médias et de la configuration d'AzuraCast sur un autre disque
# En échec, un courriel au propriétaire (pipeline/deploy/systemd/radio-alerte@.service). Le script
# refuse lui-même d'écrire si /media/plex n'est pas monté.
OnFailure=radio-alerte@%N.service

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=%h/aubesonore/azuracast/scripts/backup-media.sh
TimeoutStartSec=2h
