[Unit]
Description=AubeSonore : sauvegarde restic chiffrée des médias et de la configuration d'AzuraCast sur un autre disque

[Service]
Type=oneshot
# Le jeton du battement de cœur seul (GATUS_TOKEN), à part de .env que lit le conteneur.
EnvironmentFile=%h/aubesonore/azuracast/gatus.env
Nice=19
IOSchedulingClass=idle
ExecStart=%h/aubesonore/azuracast/scripts/backup-media.sh
TimeoutStartSec=2h
# Battement de cœur vers Gatus, même en échec (même mécanisme que radio-backup).
ExecStopPost=-/bin/sh -c 'curl -fsS -m 10 -X POST -H "Authorization: Bearer $GATUS_TOKEN" "http://127.0.0.1:8050/api/v1/endpoints/radio_sauvegarde-medias/external?success=$([ "$SERVICE_RESULT" = success ] && echo true || echo false)&error=$SERVICE_RESULT"'
